            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RECHAZADA\",\n  \"motivo\": \"Perfil no se ajusta a la dedicación\"\n}"
            },
            "url": "{{baseUrl}}/proyectos/{{proyectoId}}/postulaciones/{{colaboradorId}}/estado"
          }
        }
      ]
    },
    {
      "name": "07 - Asignaciones",
      "item": [
        {
          "name": "Listar asignaciones",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/asignaciones"
          }
        },
        {
          "name": "Crear asignación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201\", function () { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.datos && res.datos.asignacionId) {",
                  "    pm.environment.set(\"asignacionId\", res.datos.asignacionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"colaboradorId\": \"{{colaboradorId}}\",\n  \"proyectoId\": \"{{proyectoId}}\",\n  \"porcentajeDedicacion\": 40,\n  \"horasAsignadas\": 64\n}"
            },
            "url": "{{baseUrl}}/asignaciones"
          }
        },
        {
          "name": "Consultar asignación",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/asignaciones/{{asignacionId}}"
          }
        },
        {
          "name": "Consultar asignaciones activas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/asignaciones/activas"
          }
