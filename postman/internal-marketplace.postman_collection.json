    {
      "name": "00 - Health",
      "item": [
        {
          "name": "Verificar API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Respuesta exitosa y status ok\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.datos.status).to.eql(\"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
