            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"porcentajeDedicacion\": 50,\n  \"horasAsignadas\": 80\n}"
            },
            "url": "{{baseUrl}}/asignaciones/{{asignacionId}}"
          }
        },
        {
          "name": "Desvincular colaborador",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"DESVINCULADA\"\n}"
            },
            "url": "{{baseUrl}}/asignaciones/{{asignacionId}}/estado"
          }
        }
      ]
    },
