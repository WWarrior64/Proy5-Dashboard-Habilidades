{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "eqeqeq": ["warn", "always"],
    "curly": ["warn", "all"],
    "no-var": "warn",
    "prefer-const": "warn"
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/", "*.config.js"]
}